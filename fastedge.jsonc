{
  "$schema": "https://raw.githubusercontent.com/godronus-org/toolkit/v1/schema/fastedge.schema.json",
  // Gcore-internal deploy config. If you copied this repo, it does nothing for
  // you — delete it, and see .github/workflows/deploy.yaml.example instead.
  "kind": "template",
  "runtime": "cdn-filter",
  "language": "rust",
  "category": ["traffic"],

  "template": {
    "name": "gdr-Transform HTML to Markdown",
    "description": "Transform origin's HTML responses to Markdown format when request header \"Accept\" is equal to \"text/markdown\". Particularly useful for AI Agents.",
    "params": []
  },

  // POC: test-account template ids only (F17) — never live ids. Names start
  // with "gdr-" so POC-made resources are recognisable in the portal (apps
  // reject "-_-": names must match ^[a-z0-9][a-z0-9-]*[a-z0-9]$).
  "environments": {
    "preprod": { "template": { "id": 859, "name": "gdr-Transform HTML to Markdown - preprod" } },
    "prod": { "template": { "id": 222 } }
  }
}
