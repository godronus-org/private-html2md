// Public mirror (T34): on each prod release these tracked files, plus the
// .github/mirror/ overlay, are pushed to godronus-org/html2md as one commit.
// Its CI and Deploy workflows are generated by the export (toolkit
// templates/public/); add files under .github/mirror/ only for exceptions.
{
  "include": [
    "src/**",
    "Cargo.toml",
    "Cargo.lock",
    ".cargo/**",
    "fastedge-test/*.mjs",
    "fastedge-test/package*.json",
    "fastedge-config.test.json",
    "instructions.md",
    "README.md",
    "LICENSE",
    ".gitignore",
    "CHANGELOG.md"
  ]
}
